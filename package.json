    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0",
    "@pandacss/dev": "^0.21.0",
    "@ark-ui/react": "^1.0.0",
    "typescript": "^5.0.0"
  }
